  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7DCFFF", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "string.regexp"],
      "settings": { "foreground": "#FFA0A0" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#FFFF60" }
    },
    {
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#FFA0A0" }
    },
    {
      "scope": ["constant.other.symbol"],
      "settings": { "foreground": "#FFFFFF" }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.operator.word"],
      "settings": { "foreground": "#FF6B6B", "fontStyle": "bold" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#FFFFFF" }
    },
    {
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#FF6B6B", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.function", "support.function", "entity.name.method"],
      "settings": { "foreground": "#FFFF60", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.type", "support.type", "entity.other.inherited-class"],
      "settings": { "foreground": "#60FF60", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.class", "entity.other.attribute-name"],
      "settings": { "foreground": "#60FF60" }
    },
    {
      "scope": ["entity.name.tag", "tag"],
      "settings": { "foreground": "#FF6B6B" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#7DCFFF" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#FFFFFF" }
    },
    {
      "scope": ["variable.language", "variable.other.constant"],
      "settings": { "foreground": "#FFA0A0" }
    },
    {
      "scope": ["meta.preprocessor", "preprocessor"],
      "settings": { "foreground": "#FF80FF" }
    },
    {
      "scope": ["punctuation", "punctuation.definition", "punctuation.separator"],
      "settings": { "foreground": "#C0C0C0" }
    },
    {
      "scope": ["punctuation.special"],
      "settings": { "foreground": "#FFFF60" }
    },
    {
      "scope": ["support.constant", "support.variable"],
      "settings": { "foreground": "#FFA0A0" }
    },
    {
      "scope": ["support.type.property-name"],
      "settings": { "foreground": "#7DCFFF" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FFFFFF", "background": "#FF0000" }
    },
    {
      "scope": ["string.quoted.docstring", "comment.block.documentation"],
      "settings": { "foreground": "#7DCFFF", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#FF6B6B", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.heading.1"],
      "settings": { "foreground": "#FF6B6B", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.heading.2"],
      "settings": { "foreground": "#60FF60", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.heading.3"],
      "settings": { "foreground": "#FFFF60", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.heading.4"],
      "settings": { "foreground": "#0054E3", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.heading.5"],
      "settings": { "foreground": "#FF80FF", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.heading.6"],
      "settings": { "foreground": "#40FFFF", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.list"],
      "settings": { "foreground": "#FFFFFF" }
    },
    {
      "scope": ["markup.link", "markup.underline.link"],
      "settings": { "foreground": "#7DCFFF" }
    },
    {
      "scope": ["markup.strikethrough"],
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "scope": ["markup.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#C0C0C0" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#7DCFFF", "fontStyle": "italic" }
    },
    {
      "scope": ["meta.diff.header"],
      "settings": { "foreground": "#7DCFFF" }
    },
    {
      "scope": ["source.diff", "meta.diff"],
      "settings": { "foreground": "#FFFFFF" }
    },
    {
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": { "foreground": "#60FF60" }
    },
    {
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": { "foreground": "#FF6B6B" }
    },
    {
      "scope": ["markup.changed", "diff.changed"],
      "settings": { "foreground": "#FFFF60" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": { "foreground": "#FFFF60", "fontStyle": "bold" },
    "method": { "foreground": "#FFFF60", "fontStyle": "bold" },
    "class": { "foreground": "#60FF60", "fontStyle": "bold" },
    "interface": { "foreground": "#60FF60", "fontStyle": "bold" },
    "enum": { "foreground": "#60FF60", "fontStyle": "bold" },
    "type": { "foreground": "#60FF60" },
    "typeParameter": { "foreground": "#FFA0A0" },
    "property": { "foreground": "#7DCFFF" },
    "variable": { "foreground": "#FFFFFF" },
    "variable.readonly": { "foreground": "#FFA0A0" },
    "namespace": { "foreground": "#FF80FF" },
    "parameter": { "foreground": "#FFFF60" },
    "modifier": { "foreground": "#FF6B6B" },
    "macro": { "foreground": "#FF80FF" },
    "keyword": { "foreground": "#FF6B6B", "fontStyle": "bold" },
    "string": { "foreground": "#FFA0A0" },
    "number": { "foreground": "#FFFF60" },
    "boolean": { "foreground": "#FFA0A0" },
    "enumMember": { "foreground": "#FFFF60" },
    "event": { "foreground": "#FFFF60" },
    "operator": { "foreground": "#FFFFFF" },
    "comment": { "foreground": "#7DCFFF", "fontStyle": "italic" }
  }
