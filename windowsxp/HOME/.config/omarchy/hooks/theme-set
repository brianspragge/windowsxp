#!/bin/bash

# Point the background symlink at a source image so the next theme switch
# starts fresh, preventing cycling of background images when switching from
# windowsxp to windowsxp-green.
THEME_DIR="$HOME/.config/omarchy/themes/$1"
BG_SRC="$THEME_DIR/backgrounds/01 - Bliss.jpg"

if [[ -f $BG_SRC ]]; then
  ln -sf "$BG_SRC" "$HOME/.local/state/omarchy/current/background"
fi
